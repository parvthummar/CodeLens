# Python virtual environment
backend/cr_venv/

# Environment variables
backend/.env
backend/.env.*
# ...except the committed template, which the pattern above would otherwise catch.
!backend/.env.example

# Python cache
backend/**/__pycache__/
backend/**/*.py[cod]

# Test & lint caches
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Build artifacts
backend/build/
backend/dist/
backend/*.egg-info/

# SQLite databases
backend/*.db
backend/*.sqlite3

# Logs
backend/*.log

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Frontend logs
frontend/logs
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*

# Frontend build/deps
frontend/node_modules
frontend/dist
frontend/dist-ssr
frontend/*.local

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db


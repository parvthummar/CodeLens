# Copy to backend/.env and fill in. Never commit the real file.
#
# Under `docker compose up`, DATABASE_URL and DATABASE_URL_DIRECT are overridden
# to point at the postgres container — leave them as they are below unless you
# want to run the backend directly on the host against a hosted database.

# --- Database -------------------------------------------------------------
# Local (docker compose): one URL serves both, since there is no PgBouncer.
DATABASE_URL=postgresql://codelens:codelens@localhost:5432/codelens
DATABASE_URL_DIRECT=postgresql://codelens:codelens@localhost:5432/codelens

# Hosted (Neon): the pooled endpoint for the app, the direct one for Alembic.
# The direct host is the same host with "-pooler" removed. DDL through a
# transaction pooler is unreliable, so the two cannot be the same value.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Queue ----------------------------------------------------------------
# Redis delivers indexing jobs to the worker. Under docker compose this is
# overridden to the redis container. Job state lives in Postgres, so a Redis
# restart loses nothing the worker's reconciler cannot recover.
REDIS_URL=redis://localhost:6379
# Indexing runs one worker executes at once — the ceiling on simultaneous
# clones and, through them, in-flight LLM calls.
WORKER_CONCURRENCY=2
# Entities per describe -> embed -> write cycle. Bounds peak memory by chunk
# size rather than by repository size.
INDEXING_CHUNK_SIZE=200
# Includes the first run, so 3 means one try plus two retries.
JOB_MAX_ATTEMPTS=3

# --- Auth -----------------------------------------------------------------
# Required, no default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OpenAI ---------------------------------------------------------------
# Needed to index a repo and to search. Signup, login and the project CRUD
# routes work without it.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_LLM_MODEL=gpt-4o-mini

# --- Pinecone -------------------------------------------------------------
# The index must already exist with dimension 1024 (matching
# OPENAI_EMBEDDING_DIMENSIONS above); the app does not create it.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=code-search
# Optional. Setting it skips an index-lookup round trip on cold start.
PINECONE_INDEX_HOST=
